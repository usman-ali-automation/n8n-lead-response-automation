    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const phone = $input.item.json.body.phone || '';\nconst email = $input.item.json.body.email || '';\nconst cleanPhone = phone.replace(/[\\s()-]/g, '');\n\nconst phoneFormatValid = /^\\+?[1-9]\\d{7,14}$/.test(cleanPhone);\n\n// Strip leading +1 (US country code) to get the 10-digit number\nconst digitsOnly = cleanPhone.replace(/^\\+?1?/, '');\n\nconst areaCode = digitsOnly.slice(0, 3);\nconst exchange = digitsOnly.slice(3, 6);\nconst subscriber = digitsOnly.slice(6, 10);\n\nconst allSameDigit = /^(\\d)\\1+$/.test(digitsOnly);\nconst isSequential = digitsOnly === '1234567890' || digitsOnly === '0123456789';\n\n// 555 is not a real assignable US area code — reject it outright\nconst isFakeAreaCode = areaCode === '555';\n\n// Classic reserved fake range: exchange 555, subscriber 0100-0199\nconst isReservedFake = exchange === '555' && /^01\\d{2}$/.test(subscriber);\n\n// Real numbers essentially never end in four zeros\nconst subscriberAllZeros = subscriber === '0000';\n\nconst phoneValid = phoneFormatValid && !allSameDigit && !isSequential && !isFakeAreaCode && !isReservedFake && !subscriberAllZeros;\nconst emailValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\nreturn {\n  json: {\n    ...$input.item.json.body,\n    phoneValid,\n    emailValid,\n    isValid: phoneValid && emailValid\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
